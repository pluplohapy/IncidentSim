{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incidentsim.dev/schema/incident.schema.json",
  "title": "IncidentSim task",
  "description": "Fixed schema of an IncidentSim incident manifest. Manifests are data; new tasks never require a schema change.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "incidentsim/v1" },
    "kind": { "const": "Incident" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },

  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["id", "title", "level"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 3,
          "description": "Kebab-case task id, unique across the catalog."
        },
        "title": { "type": "string", "minLength": 3 },
        "level": { "enum": ["config", "code", "db", "composite"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "estimated_minutes": { "type": "integer", "minimum": 1 }
      }
    },

    "spec": {
      "type": "object",
      "required": [
        "runtime",
        "services",
        "verify",
        "root_cause",
        "reference_solution"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "services": { "$ref": "#/$defs/services" },
        "symptoms": { "$ref": "#/$defs/symptoms" },
        "hints": { "$ref": "#/$defs/hints" },
        "fault": { "$ref": "#/$defs/fault" },
        "fault_chain": { "type": "array", "items": { "$ref": "#/$defs/fault" }, "minItems": 2 },
        "verify": { "$ref": "#/$defs/verify" },
        "root_cause": { "$ref": "#/$defs/rootCause" },
        "reference_solution": { "$ref": "#/$defs/referenceSolution" },
        "replay": { "$ref": "#/$defs/replay" },
        "distractors": { "$ref": "#/$defs/distractors" },
        "theory": { "type": "string" },
        "editable": { "type": "array", "items": { "type": "string" } },
        "workspace": { "type": "string" },
        "reference": { "type": "string" }
      }
    },

    "runtime": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["compose", "firecracker"] },
        "snapshot": { "type": "string" },
        "cpu_count": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 128 }
      }
    },

    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    },

    "service": {
      "type": "object",
      "required": ["name", "image"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "image": { "type": "string", "minLength": 3 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "command": { "type": "array", "items": { "type": "string" } },
        "healthcheck": {
          "type": "object",
          "required": ["path", "port"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "interval_seconds": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "observation": { "type": "string" }
        }
      }
    },

    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "text"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },

    "fault": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["feature_flag", "sql_config", "kill", "network", "stress"]
        },
        "target": { "type": "string", "minLength": 1 },
        "trigger": { "enum": ["on_start", "manual", "after_30s"] },
        "options": { "type": "object" },
        "breaks_loop": { "type": "boolean" }
      }
    },

    "verify": {
      "type": "object",
      "required": ["correctness", "quality"],
      "additionalProperties": false,
      "properties": {
        "correctness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "quality": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "replay": { "$ref": "#/$defs/replay" }
      }
    },

    "check": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "type": { "enum": ["http", "metric", "sql", "log", "policy", "exec", "replay", "unit"] },
        "title": { "type": "string" },
        "service": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "query": { "type": "string" },
        "sql": { "type": "string" },
        "pattern": { "type": "string" },
        "rule": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "expect": { "$ref": "#/$defs/expectation" },
        "reason": { "type": "string" },
        "file": {
          "type": "string",
          "pattern": "^/",
          "description": "Configuration file inside the container a policy check reads. Declaring it makes the check read the file the service loads at startup instead of the process environment."
        },
        "agg": { "enum": ["max", "min", "avg", "last", "p95", "slope", "delta", "resets"] },
        "window": { "$ref": "#/$defs/window" },
        "absent": { "type": "boolean" },
        "field": { "type": "string" },
        "class": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "http" } }, "required": ["type"] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "type": { "const": "metric" } }, "required": ["type"] },
          "then": { "required": ["query"] }
        },
        {
          "if": { "properties": { "type": { "const": "sql" } }, "required": ["type"] },
          "then": { "required": ["sql", "service"] }
        },
        {
          "if": { "properties": { "type": { "const": "log" } }, "required": ["type"] },
          "then": { "required": ["pattern"] }
        },
        {
          "if": { "properties": { "type": { "const": "policy" } }, "required": ["type"] },
          "then": { "required": ["rule"] }
        },
        {
          "if": { "properties": { "type": { "const": "exec" } }, "required": ["type"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "replay" } }, "required": ["type"] },
          "then": { "required": ["field"] }
        },
        {
          "if": { "properties": { "type": { "const": "unit" } }, "required": ["type"] },
          "then": { "required": [] }
        }
      ]
    },

    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" }
      }
    },

    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer" },
        "equals": { "type": "string" },
        "matches": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },

    "rootCause": {
      "type": "object",
      "required": ["summary", "layer"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "layer": { "enum": ["config", "code", "db", "infra", "composite"] },
        "signals": { "type": "array", "items": { "type": "string" } },
        "masked_by": { "type": "array", "items": { "type": "string" } }
      }
    },

    "referenceSolution": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "steps": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "string" }
      }
    },

    "replay": {
      "type": "object",
      "required": ["profile", "duration"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string" },
        "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "rps": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "target_service": { "type": "string" },
        "hooks": { "type": "array", "items": { "$ref": "#/$defs/replayHook" } }
      }
    },

    "replayHook": {
      "type": "object",
      "required": ["at", "do"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "do": { "enum": ["restart_service", "kill_service", "stub_control", "sql", "exec"] },
        "service": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "sql": { "type": "string" },
        "vars": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" }
      }
    },

    "distractors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "symptom", "masked_artifact", "fails"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "symptom": { "type": "string", "description": "Symptom id the distractor hides." },
          "masked_artifact": { "type": "string", "description": "What the distractor destroys or hides." },
          "fails": { "type": "string", "description": "Quality check id that catches the distractor." },
          "apply": { "$ref": "#/$defs/distractorApply" }
        }
      }
    },

    "distractorApply": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["env", "files", "sql", "exec", "restart", "resources"] },
        "service": { "type": "string" },
        "vars": { "type": "object", "additionalProperties": { "type": "string" } },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "sql": { "type": "array", "items": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "env" } }, "required": ["kind"] },
          "then": { "required": ["service", "vars"] }
        },
        {
          "if": { "properties": { "kind": { "const": "files" } }, "required": ["kind"] },
          "then": { "required": ["from", "to"] }
        },
        {
          "if": { "properties": { "kind": { "const": "sql" } }, "required": ["kind"] },
          "then": { "required": ["service", "sql"] }
        },
        {
          "if": { "properties": { "kind": { "const": "exec" } }, "required": ["kind"] },
          "then": { "required": ["from"] }
        },
        {
          "if": { "properties": { "kind": { "const": "restart" } }, "required": ["kind"] },
          "then": { "required": ["service"] }
        }
      ]
    }
  }
}
