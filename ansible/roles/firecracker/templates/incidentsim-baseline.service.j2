[Unit]
Description=IncidentSim baseline snapshot provisioning
After=incidentsim-network.service docker.service
Requires=incidentsim-network.service

[Service]
Type=oneshot
# The baseline snapshot is what a task reset restores. Building it takes a boot
# of the guest plus a snapshot, so it runs once at provisioning time and never
# during a session.
ExecStart=/usr/local/bin/incidentsim-guest \
    --make-baseline \
    --out {{ incidentsim_snapshot_dir }}/baseline.snap \
    --kernel {{ incidentsim_rootfs_dir }}/vmlinux \
    --rootfs {{ incidentsim_rootfs_dir }}/incidentsim_workload.squashfs
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
